        },
        {
          "id": "a-env-levels",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "A-ENV" },
            { "type": "param_row", "row": 3, "param": "op1.eg.l1", "text": "L1" },
            { "type": "param_row", "row": 4, "param": "op1.eg.l2", "text": "L2" },
            { "type": "param_row", "row": 5, "param": "op1.eg.l3", "text": "SUS" },
