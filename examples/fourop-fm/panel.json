            { "type": "param_row", "row": 3, "param": "level.p0", "text": "LEVEL" },
            { "type": "param_row", "row": 4, "param": "delay.p0", "text": "DELAY" }
          ]
        },
        {
          "id": "voice-mode",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "VOICE MODE", "part": true },
            { "type": "param_row", "row": 3, "param": "mode.p0", "text": "MODE" },
            { "type": "param_row", "row": 4, "param": "unison_count.p0", "text": "UNISON" },
            { "type": "param_row", "row": 5, "param": "unison_detune.p0", "text": "DETUNE" },
            { "type": "param_row", "row": 6, "param": "legato.p0", "text": "LEGATO" },
            { "type": "param_row", "row": 7, "param": "portamento.p0", "text": "PORTAM" },
            { "type": "param_row", "row": 8, "param": "note_priority.p0", "text": "PRIOR" }
          ]
