{
  "name": "fourop-fm",
  "home": "home",
  "operators": ["op1", "op2", "op3", "op4"],
  "mute": ["op1_mute", "op2_mute", "op3_mute", "op4_mute"],
  "global": [
    { "source": "KEY", "action": "note_on" },
    { "source": "ENC_KNOB1", "target": "algorithm", "behavior": "relative" },
    { "source": "ENC_KNOB2", "target": "cutoff", "behavior": "relative" },
    { "source": "ENC_KNOB3", "target": "res", "behavior": "relative" },
    { "source": "BTN_EDIT", "action": "push", "arg": "op" },
    { "source": "BTN_HOME", "action": "pop_home" },
    { "source": "BTN_OCT_UP", "action": "op_next" },
    { "source": "BTN_OCT_DOWN", "action": "op_prev" },
    { "source": "BTN_STOP", "action": "op_mute" }
  ],
  "contexts": {
    "home": {
      "pages": [
        {
          "id": "main",
          "widgets": [
            { "type": "label", "row": 1, "span": 2, "text": "4OP FM" },
            { "type": "param_row", "row": 4, "param": "fold", "text": "FOLD" },
            { "type": "param_row", "row": 5, "param": "master", "text": "MAST" },
            { "type": "param_row", "row": 6, "param": "pitch_rate", "text": "VIB RATE" },
            { "type": "param_row", "row": 7, "param": "pitch_depth", "text": "VIB DEPTH" }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_KNOB4", "slot": 0, "behavior": "relative" },
        { "source": "ENC_KNOB5", "slot": 1, "behavior": "relative" },
        { "source": "ENC_KNOB6", "slot": 2, "behavior": "relative" },
        { "source": "ENC_KNOB7", "slot": 3, "behavior": "relative" }
      ]
    },
    "op": {
      "pages": [
        {
          "id": "pitch",
          "widgets": [
            { "type": "label", "row": 1, "span": 2, "text": "OP - PITCH" },
            { "type": "param_row", "row": 4, "param": "op1.ph.inc_ratio", "text": "RATIO", "unit": "x" },
            { "type": "param_row", "row": 5, "param": "op1.fb.level", "text": "FB" },
            { "type": "param_row", "row": 6, "param": "op1.osc.waveform", "text": "WAVE" },
            { "type": "param_row", "row": 7, "param": "op1.vca.level", "text": "LEVEL" }
          ]
        },
        {
          "id": "env-rates",
          "widgets": [
            { "type": "label", "row": 1, "span": 2, "text": "OP - ENV RATES" },
            { "type": "param_row", "row": 4, "param": "op1.eg.r1", "text": "ATK" },
            { "type": "param_row", "row": 5, "param": "op1.eg.r2", "text": "DCY1" },
            { "type": "param_row", "row": 6, "param": "op1.eg.r3", "text": "DCY2" },
            { "type": "param_row", "row": 7, "param": "op1.eg.r4", "text": "REL" },
            { "type": "envelope", "row": 9, "span": 5, "param": "op1.eg.r1" }
          ]
        },
        {
          "id": "env-levels",
          "widgets": [
            { "type": "label", "row": 1, "span": 2, "text": "OP - ENV LEVELS" },
            { "type": "param_row", "row": 4, "param": "op1.eg.l1", "text": "L1" },
            { "type": "param_row", "row": 5, "param": "op1.eg.l2", "text": "L2" },
            { "type": "param_row", "row": 6, "param": "op1.eg.l3", "text": "SUS" },
            { "type": "envelope", "row": 8, "span": 5, "param": "op1.eg.r1" }
          ]
        },
        {
          "id": "trem",
          "widgets": [
            { "type": "label", "row": 1, "span": 2, "text": "OP - TREMOLO" },
            { "type": "param_row", "row": 4, "param": "op1.lfo.rate", "text": "RATE" },
            { "type": "param_row", "row": 5, "param": "op1.lfo.depth", "text": "DEPTH" }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_KNOB4", "slot": 0, "behavior": "relative" },
        { "source": "ENC_KNOB5", "slot": 1, "behavior": "relative" },
        { "source": "ENC_KNOB6", "slot": 2, "behavior": "relative" },
        { "source": "ENC_KNOB7", "slot": 3, "behavior": "relative" },
        { "source": "ENC_SELECT", "action": "next_page" }
      ]
    }
  }
}
