            { "type": "param_row", "row": 3, "param": "fenv_a", "text": "ATK" },
            { "type": "param_row", "row": 4, "param": "fenv_d", "text": "DCY" },
            { "type": "param_row", "row": 5, "param": "fenv_s", "text": "SUS" },
            { "type": "param_row", "row": 6, "param": "fenv_r", "text": "REL" },
            { "type": "param_row", "row": 7, "param": "fenv_depth", "text": "DEPTH" }
          ]
        },
        {
          "id": "fold",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "FOLD" },
            { "type": "param_row", "row": 3, "param": "fold_on", "text": "ON" },
            { "type": "param_row", "row": 4, "param": "fold_threshold", "text": "THRESH" },
            { "type": "param_row", "row": 5, "param": "fold_folds", "text": "FOLDS" },
            { "type": "param_row", "row": 6, "param": "fold_type", "text": "TYPE" }
          ]
