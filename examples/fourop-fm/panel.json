{
  "name": "fourop-fm",
  "home": "home",
  "alg": "algorithm",
  "parts": 2,
  "operators": ["op1", "op2", "op3", "op4"],
  "mute": ["op1_mute", "op2_mute", "op3_mute", "op4_mute"],
  "global": [
    { "source": "KEY", "action": "note_on" },
    { "source": "ENC_ALGORITHM", "target": "algorithm", "behavior": "relative" },
    { "source": "BTN_EDIT", "action": "switch", "arg": "edit" },
    { "source": "BTN_ENV", "action": "switch", "arg": "env" },
    { "source": "BTN_LFO", "action": "switch", "arg": "lfo" },
    { "source": "BTN_FX", "action": "switch", "arg": "fx" },
    { "source": "BTN_GLO", "action": "switch", "arg": "glo" },
    { "source": "BTN_HOME", "action": "pop_home" },
    { "source": "BTN_SEL", "action": "op_next" },
    { "source": "ENC_SELECT", "action": "page" }
  ],
  "contexts": {
    "home": {
      "pages": [
        {
          "id": "env",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "ENV" },
            { "type": "envelope", "row": 3, "span": 3,
              "params": ["op1.eg.r1", "op1.eg.r2", "op1.eg.r3", "op1.eg.r4", "op1.eg.l1", "op1.eg.l2", "op1.eg.l3"] },
            { "type": "envelope", "row": 6, "span": 3,
              "params": ["op2.eg.r1", "op2.eg.r2", "op2.eg.r3", "op2.eg.r4", "op2.eg.l1", "op2.eg.l2", "op2.eg.l3"] },
            { "type": "envelope", "row": 9, "span": 3,
              "params": ["op3.eg.r1", "op3.eg.r2", "op3.eg.r3", "op3.eg.r4", "op3.eg.l1", "op3.eg.l2", "op3.eg.l3"] },
            { "type": "envelope", "row": 12, "span": 3,
              "params": ["op4.eg.r1", "op4.eg.r2", "op4.eg.r3", "op4.eg.r4", "op4.eg.l1", "op4.eg.l2", "op4.eg.l3"] }
          ]
        },
        {
          "id": "scope",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "SCOPE" },
            { "type": "scope", "row": 3, "span": 3, "channel": 0 },
            { "type": "scope", "row": 6, "span": 3, "channel": 2 },
            { "type": "scope", "row": 9, "span": 3, "channel": 4 },
            { "type": "scope", "row": 12, "span": 3, "channel": 6 }
          ]
        },
        {
          "id": "spectro",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "SPECTRO" },
            { "type": "spectro", "row": 3, "span": 3, "channel": 0 },
            { "type": "spectro", "row": 6, "span": 3, "channel": 2 },
            { "type": "spectro", "row": 9, "span": 3, "channel": 4 },
            { "type": "spectro", "row": 12, "span": 3, "channel": 6 }
          ]
        },
        {
          "id": "part-scope",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "PARTS" },
            { "type": "scope", "row": 4, "span": 4, "channel": 0 },
            { "type": "scope", "row": 9, "span": 4, "channel": 1 }
          ]
        },
        {
          "id": "part-spectro",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "PARTS" },
            { "type": "spectro", "row": 4, "span": 4, "channel": 0 },
            { "type": "spectro", "row": 9, "span": 4, "channel": 1 }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_KNOB1", "slot": 0, "behavior": "relative" },
        { "source": "ENC_KNOB2", "slot": 1, "behavior": "relative" },
        { "source": "ENC_KNOB3", "slot": 2, "behavior": "relative" },
        { "source": "ENC_KNOB4", "slot": 3, "behavior": "relative" }
      ]
    },
    "edit": {
      "pages": [
        {
          "id": "op",
          "widgets": [
            { "type": "subheader", "row": 2, "text": "OP" },
            { "type": "param_row", "row": 3, "param": "op1.ph.inc_ratio", "text": "RATIO" },
            { "type": "param_row", "row": 4, "param": "op1.vca.level", "text": "LEVEL" },
