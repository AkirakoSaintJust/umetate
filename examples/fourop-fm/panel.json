{
  "name": "fourop-fm",
  "home": "home",
  "operators": ["op1", "op2", "op3", "op4"],
  "mute": ["op1_mute", "op2_mute", "op3_mute", "op4_mute"],
  "global": [
    { "source": "KEY", "action": "note_on" },
    { "source": "ENC_ALGORITHM", "target": "algorithm", "behavior": "relative" },
    { "source": "BTN_EDIT", "action": "switch", "arg": "op" },
    { "source": "BTN_HOME", "action": "pop_home" },
    { "source": "BTN_FX", "action": "switch", "arg": "fx" },
    { "source": "BTN_GLO", "action": "switch", "arg": "glo" }
  ],
  "contexts": {
    "home": {
      "pages": [
        {
          "id": "main",
          "widgets": [
            { "type": "status", "row": 1, "span": 2, "param": "algorithm" },
            { "type": "param_row", "row": 4, "param": "cutoff", "text": "CUTOFF" },
            { "type": "param_row", "row": 5, "param": "res", "text": "RES" },
            { "type": "param_row", "row": 6, "param": "fold", "text": "FOLD" },
            { "type": "param_row", "row": 7, "param": "feedback", "text": "FEEDBACK" }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_KNOB1", "slot": 0, "behavior": "relative" },
        { "source": "ENC_KNOB2", "slot": 1, "behavior": "relative" },
        { "source": "ENC_KNOB3", "slot": 2, "behavior": "relative" },
        { "source": "ENC_KNOB4", "slot": 3, "behavior": "relative" }
      ]
    },
    "op": {
      "pages": [
        {
          "id": "pitch",
          "widgets": [
            { "type": "status", "row": 1, "span": 2, "param": "algorithm" },
            { "type": "param_row", "row": 4, "param": "op1.ph.inc_ratio", "text": "RATIO", "unit": "x" },
            { "type": "param_row", "row": 5, "param": "op1.vca.level", "text": "LEVEL" },
            { "type": "param_row", "row": 6, "param": "op1.fb.level", "text": "FEEDBACK" },
            { "type": "param_row", "row": 7, "param": "op1.osc.waveform", "text": "WAVE" }
          ]
        },
        {
          "id": "env-rates",
          "widgets": [
            { "type": "status", "row": 1, "span": 2, "param": "algorithm" },
            { "type": "param_row", "row": 4, "param": "op1.eg.r1", "text": "ATK" },
            { "type": "param_row", "row": 5, "param": "op1.eg.r2", "text": "DCY1" },
            { "type": "param_row", "row": 6, "param": "op1.eg.r3", "text": "DCY2" },
            { "type": "param_row", "row": 7, "param": "op1.eg.r4", "text": "REL" },
            { "type": "envelope", "row": 9, "span": 5,
              "params": ["op1.eg.r1", "op1.eg.r2", "op1.eg.r3", "op1.eg.r4", "op1.eg.l1", "op1.eg.l2", "op1.eg.l3"] }
          ]
        },
        {
          "id": "env-levels",
          "widgets": [
            { "type": "status", "row": 1, "span": 2, "param": "algorithm" },
            { "type": "param_row", "row": 4, "param": "op1.eg.l1", "text": "L1" },
            { "type": "param_row", "row": 5, "param": "op1.eg.l2", "text": "L2" },
            { "type": "param_row", "row": 6, "param": "op1.eg.l3", "text": "SUS" },
            { "type": "envelope", "row": 8, "span": 5,
              "params": ["op1.eg.r1", "op1.eg.r2", "op1.eg.r3", "op1.eg.r4", "op1.eg.l1", "op1.eg.l2", "op1.eg.l3"] }
          ]
        },
        {
          "id": "trem",
          "widgets": [
            { "type": "status", "row": 1, "span": 2, "param": "algorithm" },
            { "type": "param_row", "row": 4, "param": "op1.lfo.rate", "text": "RATE" },
            { "type": "param_row", "row": 5, "param": "op1.lfo.depth", "text": "DEPTH" }
          ]
        },
        {
          "id": "mute",
          "widgets": [
            { "type": "status", "row": 1, "span": 2, "param": "algorithm" },
            { "type": "param_row", "row": 4, "param": "op1_mute", "text": "OP1" },
            { "type": "param_row", "row": 5, "param": "op2_mute", "text": "OP2" },
            { "type": "param_row", "row": 6, "param": "op3_mute", "text": "OP3" },
            { "type": "param_row", "row": 7, "param": "op4_mute", "text": "OP4" }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_KNOB1", "slot": 0, "behavior": "relative" },
        { "source": "ENC_KNOB2", "slot": 1, "behavior": "relative" },
        { "source": "ENC_KNOB3", "slot": 2, "behavior": "relative" },
        { "source": "ENC_KNOB4", "slot": 3, "behavior": "relative" },
        { "source": "ENC_SELECT", "action": "next_page" },
        { "source": "BTN_SEL", "action": "op_next" }
      ]
    },
    "fx": {
      "pages": [
        {
          "id": "fx",
          "widgets": [
            { "type": "label", "row": 1, "span": 2, "text": "FX" },
            { "type": "param_row", "row": 4, "param": "cutoff", "text": "CUTOFF" },
            { "type": "param_row", "row": 5, "param": "res", "text": "RES" },
            { "type": "param_row", "row": 6, "param": "fold", "text": "FOLD" }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_KNOB1", "slot": 0, "behavior": "relative" },
        { "source": "ENC_KNOB2", "slot": 1, "behavior": "relative" },
        { "source": "ENC_KNOB3", "slot": 2, "behavior": "relative" },
        { "source": "ENC_KNOB4", "slot": 3, "behavior": "relative" }
      ]
    },
    "glo": {
      "pages": [
        {
          "id": "mod",
          "widgets": [
            { "type": "label", "row": 1, "span": 2, "text": "GLOBAL" },
            { "type": "param_row", "row": 4, "param": "pitch_rate", "text": "VIB RATE" },
            { "type": "param_row", "row": 5, "param": "pitch_depth", "text": "VIB DEPTH" },
            { "type": "param_row", "row": 6, "param": "penv_base", "text": "P-ENV BASE" },
            { "type": "param_row", "row": 7, "param": "penv_rate", "text": "P-ENV RATE" }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_KNOB1", "slot": 0, "behavior": "relative" },
        { "source": "ENC_KNOB2", "slot": 1, "behavior": "relative" },
        { "source": "ENC_KNOB3", "slot": 2, "behavior": "relative" },
        { "source": "ENC_KNOB4", "slot": 3, "behavior": "relative" }
      ]
    }
  }
}
