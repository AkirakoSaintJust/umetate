{
  "name": "accept",
  "home": "home",
  "global": [
    { "source": "KEY", "action": "note_on" },
    { "source": "BTN_SEQ", "action": "push", "arg": "step" },
    { "source": "BTN_EDIT", "action": "push", "arg": "edit" },
    { "source": "BTN_HOME", "action": "pop_home" }
  ],
  "contexts": {
    "home": {
      "pages": [
        { "id": "home", "widgets": [ { "type": "label", "row": 1, "text": "HOME" } ] }
      ]
    },
    "edit": {
      "pages": [
        {
          "id": "edit",
          "widgets": [
            { "type": "label", "row": 1, "text": "EDIT" },
            { "type": "param_row", "row": 3, "param": "cutoff", "text": "CUT" }
          ]
        }
      ],
      "bindings": [
        { "source": "ENC_PRESETS", "target": "cutoff", "behavior": "relative" }
      ]
    },
    "step": {
      "pages": [
        { "id": "step", "widgets": [ { "type": "label", "row": 1, "text": "STEP" } ] }
      ],
      "bindings": [
        { "source": "KEY", "action": "set_step" }
      ]
    }
  }
}
