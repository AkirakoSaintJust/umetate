{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umetate.dev/schema/patch.schema.json",
  "title": "umetate patch (instrument)",
  "description": "The declarative synth: macros + node instances + wires + voice/global zones + a tables section. The generator AOT-compiles this to SoA state and one fused monomorphic render. Reserved voice-zone source names: `gate` (event) and `velocity` (control) are wireable allocator outputs; `note` is an allocator binding (note x ratio -> phasor inc via a note_derived macro param). See docs/roadmap.md §3.1, §12.4.",
  "type": "object",
  "required": ["name", "voices"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "voices": { "type": "integer", "minimum": 1, "maximum": 64 },
    "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 96000 },
    "tables": { "type": "object", "additionalProperties": { "$ref": "#/$defs/table" } },
    "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/param_binding" } },
    "macros": { "type": "object", "additionalProperties": { "$ref": "#/$defs/macro" } },
    "voice": { "$ref": "#/$defs/zone" },
    "global": { "$ref": "#/$defs/zone" }
  },
  "$defs": {
    "table": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["wavetable", "segments", "spectrum", "phase_map", "routing"] },
        "shape": { "enum": ["sine", "triangle", "square", "saw"], "description": "wavetable only" },
        "size": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "harmonics": { "type": "array", "items": { "type": "integer" }, "description": "spectrum only" },
        "points": { "type": "array", "items": { "type": "array", "items": { "type": "integer" } }, "description": "segments/phase_map inline spec" }
      }
    },
    "param_binding": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "description": "flattened <instance>.<param> path" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "default": { "type": "integer" },
        "curve": { "enum": ["linear", "log"] },
        "unit": { "type": "string" },
        "display": {
          "enum": ["raw", "ratio", "pct", "pct_inv", "onoff", "onoff_inv", "off_pct", "hz", "semi", "cent", "wave", "filter", "fold", "mode", "priority", "note", "porta"],
          "description": "the on-screen form of the value (the panel's per-param display scale): raw = the integer; ratio = a Q16 multiplier (65536 = 1.00 base pitch); pct = 0..100% of [min,max]; pct_inv = inverted % (100% at min); onoff = off/on; off_pct = \"off\" at <= 0, else %; hz = a Q32 rate as N.N Hz; semi = a bipolar Q15 as +/-N.NN st. Default raw."
        },
        "rate": { "enum": ["sample", "block"] },
        "modulatable": { "type": "boolean" }
      }
    },
    "zone": {
      "type": "object",
      "required": ["nodes"],
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
        "wires": { "type": "array", "items": { "$ref": "#/$defs/wire" } },
        "voice_out": {
          "type": "string",
          "description": "the voice-zone signal (by <instance>.<port>) summed into the global bus (voice zone only)"
        }
      }
    },
    "instance": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "type": "string", "description": "a node name or a macro name" },
        "params": { "type": "object", "additionalProperties": { "type": ["integer", "string"] }, "description": "an integer value, or a string naming a `tables:` entry (the `table` param kind)" },
        "ins": { "type": "object", "additionalProperties": { "type": "string" }, "description": "input port -> C expression override (e.g. a global gate for a per-voice node)" }
      }
    },
    "wire": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "description": "a port, <instance>.<port>, or a reserved voice source (gate, velocity, trigger)" },
        "to": { "type": "string", "description": "<instance>.<port>" }
      }
    },
    "param_target": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "description": "inner <instance>.<param> (port param) or <instance>.<state> (state, set at note-on)" },
        "note_derived": { "type": "boolean", "description": "multiply by note_to_inc(note) at note-on (phasor inc)" },
        "note_cutoff": { "type": "boolean", "description": "set to 2*sin(pi * note_to_inc * ratio / 2^32) at note-on (a note-tracked filter coefficient)" }
      }
    },
    "macro": {
      "type": "object",
      "required": ["ins", "outs", "nodes", "wires"],
      "additionalProperties": false,
      "properties": {
        "ins": { "type": "object", "additionalProperties": { "enum": ["event", "control", "audio"] } },
        "outs": { "type": "object", "additionalProperties": { "enum": ["event", "control", "audio"] } },
        "params": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "description": "macro param name -> inner <instance>.<param>" },
              { "$ref": "#/$defs/param_target" }
            ]
          }
        },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
        "wires": { "type": "array", "items": { "$ref": "#/$defs/wire" } }
      }
    }
  }
}
