{
  "summary": "The complete DX-style FM operator: phasor + osc(12 waveforms) + dx_env(rate/level) + vca(level), with 1-sample self-feedback, a q16 `ratio` frequency multiplier (runtime), a per-op amplitude LFO (tremolo), and a `pitch` input (the shared vibrato LFO).",
  "ins": { "fm": "audio", "pitch": "control" },
  "outs": { "audio": "audio" },
  "params": {
    "ratio": { "target": "ph.inc", "note_derived": true },
    "waveform": "osc.waveform",
    "level": "vca.level",
    "feedback": "fb.level",
    "trem_rate": "lfo.rate",
    "trem_depth": "lfo.depth",
    "r1": "eg.r1", "r2": "eg.r2", "r3": "eg.r3", "r4": "eg.r4",
    "l1": "eg.l1", "l2": "eg.l2", "l3": "eg.l3"
  },
  "nodes": [
    { "id": "ph", "type": "phasor" },
    { "id": "osc", "type": "osc" },
    { "id": "eg", "type": "dx_env" },
    { "id": "lfo", "type": "lfo", "params": { "rate": 389566, "depth": 0 } },
    { "id": "trem", "type": "vca" },
    { "id": "cvsum", "type": "mix" },
    { "id": "vca", "type": "vca" },
    { "id": "fb", "type": "vca" },
    { "id": "d1", "type": "delay1" },
    { "id": "sum", "type": "mix" }
  ],
  "wires": [
    { "from": "fm", "to": "sum.in0" },
    { "from": "d1.out", "to": "sum.in1" },
    { "from": "pitch", "to": "ph.pitch" },
    { "from": "sum.audio", "to": "ph.fm" },
    { "from": "ph.phase", "to": "osc.phase" },
    { "from": "osc.audio", "to": "vca.audio" },
    { "from": "eg.cv", "to": "trem.audio" },
    { "from": "lfo.cv", "to": "trem.cv" },
    { "from": "eg.cv", "to": "cvsum.in0" },
    { "from": "trem.audio", "to": "cvsum.in1" },
    { "from": "cvsum.audio", "to": "vca.cv" },
    { "from": "vca.audio", "to": "fb.audio" },
    { "from": "fb.audio", "to": "d1.in" },
    { "from": "vca.audio", "to": "audio" }
  ]
}
