{
  "summary": "The complete DX-style FM operator: phasor + osc(12 waveforms) + dx_env(rate/level) + tl(total-level), with per-op self-feedback (the `feedback` param: the level-gained output, averaged over two samples and delayed one sample), velocity → amplitude (`vel_amp`), velocity → FM (`vel_fm`), velocity → envelope rate (`vel_rate`), a q16 `ratio` frequency multiplier (runtime), a per-op `detune` (cents -50..50), a per-op amplitude LFO (tremolo), a per-op `mute` gate, a `pitch` input (the shared vibrato LFO), per-op key-follow (level + feedback + A-ENV LO/HI) and velocity-follow (level + feedback + A-ENV amount), driven by a shared `bp` (breakpoint), `kon` (key sensitivity switch) and `von` (velocity sensitivity) input.",
  "ins": { "fm": "audio", "pitch": "control", "bp": "control", "kon": "control", "von": "control" },
  "outs": { "audio": "audio" },
  "params": {
    "ratio": { "target": "ph.inc", "note_derived": true },
    "detune": "ph.detune",
    "waveform": "osc.waveform",
    "level": "tl.level",
    "feedback": "fb.level",
    "mute": "mute.mute",
    "vel_amp": "velamp.depth",
    "vel_fm": "velfm.depth",
    "vel_rate": "velrate.depth",
    "trem_rate": "lfo.rate",
    "trem_depth": "lfo.depth",
    "trem_wave": "lfo.wave",
    "level_ks_lo": "level_ks.lo",
    "level_ks_hi": "level_ks.hi",
    "fb_ks_lo": "fb_ks.lo",
    "fb_ks_hi": "fb_ks.hi",
    "aenv_ks_lo": "eg_ks.lo",
    "aenv_ks_hi": "eg_ks.hi",
    "level_vs": "level_vs.amount",
    "fb_vs": "fb_vs.amount",
    "aenv_vs": "eg_vs.amount",
    "r1": "eg.r1", "r2": "eg.r2", "r3": "eg.r3", "r4": "eg.r4",
    "l1": "eg.l1", "l2": "eg.l2", "l3": "eg.l3"
  },
  "nodes": [
    { "id": "ph", "type": "phasor" },
    { "id": "osc", "type": "osc" },
    { "id": "eg", "type": "dx_env", "params": { "r1": 80, "r2": 60, "r3": 50, "r4": 80, "l1": 99, "l2": 93, "l3": 87 } },
    { "id": "lfo", "type": "lfo", "params": { "rate": 389566, "depth": 0 } },
    { "id": "trem", "type": "cmul" },
    { "id": "cvsum", "type": "csum" },
    { "id": "velamp", "type": "vel_depth", "params": { "depth": 0 } },
    { "id": "ampvel", "type": "cmul" },
    { "id": "velfm", "type": "vel_depth", "params": { "depth": 0 } },
    { "id": "velrate", "type": "vel_depth", "params": { "depth": 0 } },
    { "id": "fmvel", "type": "gain" },
    { "id": "tl", "type": "tl", "params": { "level": 85 } },
    { "id": "fb", "type": "fb_tap", "params": { "level": 0 } },
    { "id": "level_ks", "type": "key_scale", "params": { "lo": 0, "hi": 0 } },
    { "id": "fb_ks", "type": "key_scale", "params": { "lo": 0, "hi": 0 } },
    { "id": "eg_ks", "type": "key_scale", "params": { "lo": 0, "hi": 0 } },
    { "id": "level_vs", "type": "vel_scale", "params": { "amount": 0 } },
    { "id": "fb_vs", "type": "vel_scale", "params": { "amount": 0 } },
    { "id": "eg_vs", "type": "vel_scale", "params": { "amount": 0 } },
    { "id": "d1", "type": "delay1" },
    { "id": "sum", "type": "mix" },
    { "id": "mute", "type": "mute" }
  ],
  "wires": [
    { "from": "fm", "to": "fmvel.audio" },
    { "from": "velfm.cv", "to": "fmvel.cv" },
    { "from": "fmvel.audio", "to": "sum.in0" },
    { "from": "d1.out", "to": "sum.in1" },
    { "from": "pitch", "to": "ph.pitch" },
    { "from": "sum.audio", "to": "ph.fm" },
    { "from": "ph.phase", "to": "osc.phase" },
    { "from": "ph.mip", "to": "osc.mip" },
    { "from": "osc.audio", "to": "tl.audio" },
    { "from": "velrate.cv", "to": "eg.rate_scale" },
    { "from": "eg.cv", "to": "trem.in0" },
    { "from": "lfo.cv", "to": "trem.in1" },
    { "from": "eg.cv", "to": "cvsum.in0" },
    { "from": "trem.cv", "to": "cvsum.in1" },
    { "from": "cvsum.cv", "to": "ampvel.in0" },
    { "from": "velamp.cv", "to": "ampvel.in1" },
    { "from": "ampvel.cv", "to": "tl.cv" },
    { "from": "bp", "to": "level_ks.bp" },
    { "from": "bp", "to": "fb_ks.bp" },
    { "from": "bp", "to": "eg_ks.bp" },
    { "from": "kon", "to": "level_ks.on" },
    { "from": "kon", "to": "fb_ks.on" },
    { "from": "kon", "to": "eg_ks.on" },
    { "from": "level_ks.k", "to": "tl.k" },
    { "from": "fb_ks.k", "to": "fb.k" },
    { "from": "eg_ks.k", "to": "eg.k" },
    { "from": "von", "to": "level_vs.on" },
    { "from": "von", "to": "fb_vs.on" },
    { "from": "von", "to": "eg_vs.on" },
    { "from": "level_vs.k", "to": "tl.vk" },
    { "from": "fb_vs.k", "to": "fb.vk" },
    { "from": "eg_vs.k", "to": "eg.vk" },
    { "from": "tl.audio", "to": "fb.audio" },
    { "from": "fb.audio", "to": "d1.in" },
    { "from": "tl.audio", "to": "mute.audio" },
    { "from": "mute.audio", "to": "audio" }
  ]
}
