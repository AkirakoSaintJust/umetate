{
  "summary": "FM operator: phasor + osc + env + vca, with a note-derived `ratio` and 1-sample `fm` in.",
  "ins": { "fm": "audio" },
  "outs": { "audio": "audio" },
  "params": { "ratio": { "target": "ph.inc", "note_derived": true } },
  "nodes": [
    { "id": "ph", "type": "phasor" },
    { "id": "osc", "type": "osc" },
    { "id": "env", "type": "env" },
    { "id": "vca", "type": "vca" }
  ],
  "wires": [
    { "from": "fm", "to": "ph.fm" },
    { "from": "ph.phase", "to": "osc.phase" },
    { "from": "osc.audio", "to": "vca.audio" },
    { "from": "env.cv", "to": "vca.cv" },
    { "from": "vca.audio", "to": "audio" }
  ]
}
